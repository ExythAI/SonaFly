{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=sonafly.db"
  },
  "Jwt": {
    "Secret": "SonaFly-Dev-Secret-Key-Must-Be-At-Least-32-Chars!",
    "Issuer": "SonaFly",
    "Audience": "SonaFlyClients",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 7
  },
  "SonaFly": {
    "ArtworkRoot": "./data/artwork",
    "DataProtectionKeyRoot": "./data/keys",
    "LibraryRoots": [],
    "Identification": {
      "Enabled": false,
      "FpcalcPath": "",
      "FfprobePath": "",
      "FfmpegPath": "",
      "MusicBrainzUserAgent": "SonaFly/1.0",
      "MaxLocalWorkers": 2,
      "MaxProviderRetries": 3,
      "RequestTimeoutSeconds": 30,
      "AcoustIdRequestsPerSecond": 3,
      "MusicBrainzRequestsPerSecond": 1,
      "EnableAudDFallback": false,
      "EnableAcrCloudFallback": false,
      "AllowSourceFileWrites": false,
      "ScoringVersion": "v0.1-recording-only",
      "EnableExactReleaseApply": false,
      "HighConfidenceThreshold": 0.85,
      "ReviewThreshold": 0.6
    },
    "Deployment": {
      "UseHttps": false,
      "EnableHsts": true,
      "HstsMaxAgeDays": 30,
      "KnownProxies": [],
      "KnownNetworks": []
    }
  }
}
