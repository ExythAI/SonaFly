# SonaFly Environment Configuration
# Copy this file to .env and update the values before deploying.

# REQUIRED: JWT signing secret (minimum 32 characters)
# Generate one with: openssl rand -base64 48
JWT_SECRET=CHANGE-ME-generate-a-random-secret-at-least-32-characters

# Initial admin password (only used on first startup, when no admin account exists).
#
# Leave this COMMENTED OUT for a production deployment. SonaFly then generates a
# one-time password, prints it once in the container log, and requires the admin to
# change it at first login:
#
#   docker compose logs sonafly | grep -A2 "one-time generated password"
#
# If you set it instead, it must be a unique strong password. Production refuses to
# start when this is set to the published development credential (Admin123!) or to a
# blank value.
#ADMIN_DEFAULT_PASSWORD=

# Database path (inside the container)
DB_CONNECTION=Data Source=/app/data/db/sonafly.db

# Artwork cache directory (inside the container)
ARTWORK_ROOT=/app/data/artwork

# Public domain name, used only by docker-compose.tls.yml. Caddy obtains a certificate
# for this name automatically, so it must resolve publicly to this host and ports 80
# and 443 must be reachable.
SONAFLY_DOMAIN=sonafly.example.com
