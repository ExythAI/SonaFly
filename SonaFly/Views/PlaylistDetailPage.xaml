<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SonaFly.Views.Controls"
             x:Class="SonaFly.Views.PlaylistDetailPage"
             Title="{Binding Title}"
             BackgroundColor="#0D0D1A">

    <Grid RowDefinitions="*,Auto" Padding="16,16,16,0">
        <ScrollView IsVisible="{Binding HasPlaylist}">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Playlist.Name}" FontSize="22" FontAttributes="Bold" TextColor="#FFE66D" />
                <Label Text="{Binding Playlist.Description}" FontSize="13" TextColor="#9AA0A6" Margin="0,0,0,4" />
                <Button Text="🗑 Delete Playlist" BackgroundColor="#FF6B6B" TextColor="White" FontSize="12"
                        CornerRadius="8" Padding="12,6" HorizontalOptions="Start" Margin="0,0,0,12"
                        Command="{Binding DeleteCommand}" />
                <CollectionView x:Name="TracksList" ItemsSource="{Binding Playlist.Items}" SelectionMode="Single"
                                SelectionChangedCommand="{Binding PlayTrackCommand}"
                                SelectionChangedCommandParameter="{Binding Source={RelativeSource Self}, Path=SelectedItem}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="Transparent" Stroke="Transparent" Padding="10,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding TrackTitle}" FontSize="14" TextColor="#E8EAED" LineBreakMode="TailTruncation" MaxLines="1" />
                                        <Label Text="{Binding ArtistName}" FontSize="11" TextColor="#9AA0A6" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="▶" FontSize="14" TextColor="#FF6B6B" VerticalTextAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#FFE66D" VerticalOptions="Center" />

        <controls:ErrorBanner />

        <!-- Controls only: the audio stays with the tab page underneath. -->
        <controls:MiniPlayerControl x:Name="MiniPlayer" Grid.Row="1" HostsPlayback="False" />
    </Grid>
</ContentPage>
