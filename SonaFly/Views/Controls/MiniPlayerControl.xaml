<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="SonaFly.Views.Controls.MiniPlayerControl"
             IsVisible="{Binding IsVisible, Source={RelativeSource Self}}">

    <Grid RowDefinitions="Auto,Auto" BackgroundColor="#12121E">
        <!-- Mini player bar -->
        <Border BackgroundColor="#1A1A2E" StrokeShape="RoundRectangle 0" Stroke="Transparent" Padding="12,8"
                IsVisible="{Binding HasTrack}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                <!-- Artwork, over a placeholder that shows while it loads or when there is none -->
                <Border WidthRequest="42" HeightRequest="42" BackgroundColor="#252540" Stroke="Transparent"
                        StrokeShape="RoundRectangle 6" Padding="0">
                    <Image Source="{Binding ArtworkUrl}" Aspect="AspectFill" IsVisible="{Binding HasArtwork}" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                    <Label Text="{Binding TrackTitle}" FontSize="13" FontAttributes="Bold" TextColor="#E8EAED"
                           LineBreakMode="TailTruncation" MaxLines="1" />
                    <Label Text="{Binding ArtistName}" FontSize="11" TextColor="#9AA0A6"
                           LineBreakMode="TailTruncation" MaxLines="1" />
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="⏮" FontSize="18" BackgroundColor="Transparent" TextColor="#9AA0A6"
                        Padding="8,4" Command="{Binding PreviousCommand}" />
                <Button Grid.Column="3" Text="{Binding PlayPauseIcon}" FontSize="22" BackgroundColor="Transparent"
                        TextColor="#FF6B6B" Padding="8,4" Command="{Binding PlayPauseCommand}" />
                <Button Grid.Column="4" Text="⏭" FontSize="18" BackgroundColor="Transparent" TextColor="#9AA0A6"
                        Padding="8,4" Command="{Binding NextCommand}" />

                <!-- Progress and seek. Maximum is listed before Value so the value is
                     never clamped against the default maximum of 1. -->
                <Grid Grid.Row="1" Grid.ColumnSpan="5" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                    <Label Text="{Binding PositionText}" FontSize="10" TextColor="#9AA0A6"
                           VerticalOptions="Center" WidthRequest="38" HorizontalTextAlignment="End" />
                    <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0"
                            Maximum="{Binding SliderMaximum}"
                            Value="{Binding SliderPosition, Mode=OneWay}"
                            IsEnabled="{Binding HasDuration}"
                            MinimumTrackColor="#FF6B6B" MaximumTrackColor="#33334D" ThumbColor="#FF6B6B"
                            SemanticProperties.Description="Seek within the track"
                            DragStarted="OnSeekDragStarted"
                            ValueChanged="OnSeekValueChanged"
                            DragCompleted="OnSeekDragCompleted" />
                    <Label Grid.Column="2" Text="{Binding DurationText}" FontSize="10" TextColor="#9AA0A6"
                           VerticalOptions="Center" WidthRequest="38" />
                </Grid>
            </Grid>
        </Border>

        <!-- Hidden MediaElement for actual audio playback -->
        <toolkit:MediaElement x:Name="Player" IsVisible="False" Grid.Row="1"
                              HeightRequest="0" WidthRequest="0"
                              ShouldAutoPlay="True"
                              MediaOpened="OnMediaOpened"
                              PositionChanged="OnPositionChanged"
                              MediaEnded="OnMediaEnded" />
    </Grid>
</ContentView>
